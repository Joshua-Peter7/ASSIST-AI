APP_NAME=rt-suggestion-engine
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

REDIS_URL=redis://redis:6379/0
DATABASE_URL=sqlite+aiosqlite:///./data/db/app.db

VECTOR_DB_PROVIDER=weaviate
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_CLASS=DocumentChunk

LLM_PROVIDER=noop
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_BASE_URL=https://api.groq.com/openai/v1

EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=128

CACHE_TTL_SECONDS=3600
SUGGESTION_TTL_SECONDS=600
UPLOAD_DIR=./data/uploads
MAX_CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K_RAG=5
SESSION_PREFETCH_QUERY=product eligibility, pricing, objection handling, alternatives
COMPLIANCE_QUEUE=compliance
